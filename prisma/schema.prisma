// TutorConnect Platform - Connect tutors with parents/students
// Inspired by Airbnb (discovery + map) and LinkedIn (trust + profile)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
  // Sandbox local: SQLite (để live preview không cần PostgreSQL/Supabase)
  // Bản production trên GitHub dùng postgresql + DIRECT_URL (Supabase)
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           String   @default("STUDENT") // TUTOR | STUDENT
  phone          String?
  avatar         String?
  bio            String?
  address        String?
  lat            Float?
  lng            Float?
  district       String?
  city           String?
  // Tutor-specific fields
  profession     String?
  experienceYears Int?
  hourlyRate     Int?
  isVerified     Boolean  @default(false)
  education      String?
  // Default teaching mode preference
  teachesAtStudentHome Boolean @default(true)
  teachesAtOwnPlace    Boolean @default(true)
  teachesOnline        Boolean @default(false)
  travelRadiusKm       Int?    // how far tutor is willing to travel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tutorSubjects   TutorSubject[]
  bookingsAsTutor Booking[]     @relation("TutorBookings")
  bookingsAsStudent Booking[]   @relation("StudentBookings")
  reviewsGiven    Review[]      @relation("ReviewAuthor")
  reviewsReceived Review[]      @relation("ReviewTarget")
  availabilities  Availability[]
  sessions        Session[]
  conversationsAsTutor   Conversation[] @relation("TutorConversations")
  conversationsAsStudent Conversation[] @relation("StudentConversations")
  messagesSent    Message[]    @relation("MessageSender")
  // Lớp học cố định (nhóm) gia sư mở tại nhà mình — phụ huynh/học sinh đăng ký vào lớp
  groupClasses      GroupClass[]     @relation("GroupClassTutor")
  classEnrollments  ClassEnrollment[] @relation("ClassEnrollmentStudent")
  classAttendance   ClassAttendance[] @relation("ClassAttendanceStudent")
}

model Subject {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  category  String // STEM | LANGUAGE | ART | OTHER
  icon      String?
  level     String? // PRIMARY | SECONDARY | HIGH | ALL
  tutors    TutorSubject[]
  bookings  Booking[]
  classes   GroupClass[]
}

model TutorSubject {
  id          String  @id @default(cuid())
  tutorId     String
  subjectId   String
  pricePerHour Int
  description String?
  tutor       User    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id])
  @@unique([tutorId, subjectId])
}

model Booking {
  id           String   @id @default(cuid())
  studentId    String
  tutorId      String
  subjectId    String
  mode         String   // TUTOR_TO_STUDENT | STUDENT_TO_TUTOR | ONLINE
  date         String   // YYYY-MM-DD
  startTime    String   // HH:MM
  endTime      String   // HH:MM
  durationHours Float    @default(1) // P0-5: Float thay vì Int — giữ đúng 1.5h/2.5h (Int làm mất nửa giờ)
  status       String   @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED
  address      String?
  lat          Float?
  lng          Float?
  note         String?
  totalAmount  Int
  // Lớp học định kỳ (Mục đích 1 — quản lý lớp học): các buổi cùng khóa
  // chia sẻ seriesId; seriesTotal ghi tổng số buổi của khóa.
  // Buổi lẻ (không định kỳ) thì seriesId = null.
  seriesId     String?
  seriesTotal  Int?
  createdAt    DateTime @default(now())
  student      User     @relation("StudentBookings", fields: [studentId], references: [id])
  tutor        User     @relation("TutorBookings", fields: [tutorId], references: [id])
  subject      Subject  @relation(fields: [subjectId], references: [id])
  review       Review?
  cancellation Cancellation?

  @@index([seriesId])
}

// Reliability system — mọi lần hủy lịch đều được ghi lại kèm mức độ vi phạm
model Cancellation {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  cancelledBy String   // TUTOR | STUDENT — ai là người hủy
  reason      String   // lý do hủy, bắt buộc >= 5 ký tự
  bookingStatus String // PENDING | CONFIRMED — trạng thái lúc hủy
  hoursBefore Float    // khoảng cách từ lúc hủy đến giờ bắt đầu buổi học
  severity    String   // NONE | MINOR | WARNING | VIOLATION | SEVERE
  points      Int      // số điểm reliability bị trừ
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  tutorId    String
  studentId  String
  bookingId  String   @unique
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  tutor      User     @relation("ReviewTarget", fields: [tutorId], references: [id])
  student    User     @relation("ReviewAuthor", fields: [studentId], references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id])
}

model Availability {
  id         String  @id @default(cuid())
  tutorId    String
  dayOfWeek  Int     // 0=Sunday ... 6=Saturday
  startTime  String  // HH:MM
  endTime    String  // HH:MM
  tutor      User    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

// Mục đích 2 — kết nối 2 bên: hội thoại 1-1 giữa gia sư và phụ huynh/học sinh.
// Một cặp (tutor, student) chỉ có đúng một hội thoại.
model Conversation {
  id           String   @id @default(cuid())
  tutorId      String
  studentId    String
  createdAt    DateTime @default(now())
  lastMessageAt DateTime @default(now())
  tutor        User     @relation("TutorConversations", fields: [tutorId], references: [id])
  student      User     @relation("StudentConversations", fields: [studentId], references: [id])
  messages     Message[]

  @@unique([tutorId, studentId])
  @@index([tutorId, lastMessageAt])
  @@index([studentId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  // TEXT: tin nhắn thật giữa 2 bên · SYSTEM: thông báo tự động về sự kiện booking
  // (đặt lịch, xác nhận, hoàn thành, hủy) — hiển thị dạng thẻ thông báo, không phải bong bóng chat
  kind           String    @default("TEXT")
  readAt         DateTime? // null = chưa đọc bởi người nhận
  createdAt      DateTime  @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ===== Lớp học cố định (nhóm) =====
// Gia sư mở lớp học tại nhà mình theo lịch cố định hằng tuần (vd Lớp Toán 10:
// thứ 3 & thứ 5, 18:00–20:30). Phụ huynh/học sinh xem lịch + sức chứa trên hồ
// sơ gia sư và đăng ký vào lớp; gia sư duyệt từng học sinh.
model GroupClass {
  id           String   @id @default(cuid())
  tutorId      String
  subjectId    String
  title        String   // vd "Lớp Toán 10 — Nâng cao"
  gradeLevel   String?  // vd "Lớp 10", "Cấp 3", "Tiểu học"
  description  String?
  // AT_TUTOR_HOME = học tại nhà gia sư (mặc định) | ONLINE = học trực tuyến
  meetingType  String   @default("AT_TUTOR_HOME")
  address      String?  // địa điểm học (mặc định lấy địa chỉ nhà gia sư)
  capacity     Int      @default(8) // sĩ số tối đa của lớp
  monthlyFee   Int?     // học phí theo tháng (đồng)
  // OPEN = đang tuyển học sinh | PAUSED = tạm dừng tuyển | CLOSED = đã đóng lớp
  status       String   @default("OPEN")
  startDate    String?  // YYYY-MM-DD — ngày khai giảng
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tutor        User                @relation("GroupClassTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  subject      Subject             @relation(fields: [subjectId], references: [id])
  schedule     ClassScheduleSlot[]
  enrollments  ClassEnrollment[]
  sessions     ClassSession[]

  @@index([tutorId])
}

// Một buổi học cố định trong tuần của lớp: (thứ, giờ bắt đầu, giờ kết thúc)
model ClassScheduleSlot {
  id        String @id @default(cuid())
  classId   String
  dayOfWeek Int    // 0=Chủ nhật ... 6=Thứ 7 (đồng nhất Availability)
  startTime String // HH:MM
  endTime   String // HH:MM
  class     GroupClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// Một phụ huynh/học sinh đăng ký vào lớp — gia sư duyệt (APPROVED) hoặc từ chối
model ClassEnrollment {
  id              String   @id @default(cuid())
  classId         String
  studentParentId String
  studentName     String?  // tên học sinh (phụ huynh đăng ký hộ con)
  note            String?
  // PENDING = chờ gia sư duyệt | APPROVED = đã vào lớp
  // REJECTED = bị từ chối | CANCELLED = phụ huynh/học sinh rút lại
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class           GroupClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentParent   User       @relation("ClassEnrollmentStudent", fields: [studentParentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentParentId])
  @@index([classId])
  @@index([studentParentId])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== Buổi học cụ thể của lớp nhóm (Mục đích 1 — hoàn thiện quản lý lớp) =====
// Sinh tự động từ ClassScheduleSlot theo từng tuần (rolling 12 tuần, tự gia hạn
// khi gần hết). Mỗi buổi là một thực thể riêng → có thể ĐIỂM DANH (ClassAttendance),
// DỜI BUỔI (dạy bù) hoặc NGHỦ BUỔI (hủy 1 buổi) mà không đè cả lịch tuần.
model ClassSession {
  id        String   @id @default(cuid())
  classId   String
  date      String   // YYYY-MM-DD
  startTime String   // HH:MM
  endTime   String   // HH:MM
  // SCHEDULED = chưa diễn ra | COMPLETED = đã điểm danh/hoàn thành | CANCELLED = nghỉ buổi
  status    String   @default("SCHEDULED")
  note      String?  // lý do nghỉ buổi / ghi chú dời buổi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class      GroupClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance ClassAttendance[]

  @@index([classId, date])
  @@unique([classId, date, startTime])
}

// Điểm danh 1 học sinh trong 1 buổi học lớp nhóm (PRE/ABSENT)
model ClassAttendance {
  id              String   @id @default(cuid())
  sessionId       String
  studentParentId String
  // PRESENT = có mặt | ABSENT = vắng mặt
  status          String
  markedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session       ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentParent User         @relation("ClassAttendanceStudent", fields: [studentParentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentParentId])
  @@index([studentParentId])
}
