# ============================================
# .env.example — GiaSuConnect (Turlean)
# Copy file này thành .env và điền giá trị
# cp .env.example .env
# ============================================

# --- Database (BẮT BUỘC — PostgreSQL) ---
# Supabase (khuyến nghị, FREE 500MB):
# 1. Tạo account tại https://supabase.com → New project (region: Singapore)
# 2. Settings > Database > Connection string:
#    - Pooling (transaction mode, port 6543)  → DATABASE_URL (cho app runtime)
#    - Direct  (session mode, port 5432)      → DIRECT_URL   (cho prisma db push)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Local qua docker-compose (service db sẵn có):
# DATABASE_URL=postgresql://giasuconnect:giasuconnect@localhost:5432/giasuconnect
# DIRECT_URL=postgresql://giasuconnect:giasuconnect@localhost:5432/giasuconnect

# --- Cron Job Secret (tùy chọn) ---
# Bảo vệ /api/cron/reminder. Tạo random string: openssl rand -hex 32
# CRON_SECRET=your-random-secret-here

# --- App Config ---
NEXT_PUBLIC_APP_NAME=GiaSuConnect
NEXT_PUBLIC_APP_URL=http://localhost:3000
